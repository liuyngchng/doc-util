# Docker 构建上下文配置 — BuildKit multi-stage builds.
#
# 构建场景：
#   1. build/build_cli.sh   → Dockerfile.cli（COPY . . 编译 → --output dist/）
#   2. build/build.sh        → Dockerfile.server（multi-stage: COPY . . 编译 + 打包）
#   3. build/build_mcp.sh    → Dockerfile.mcp（multi-stage: COPY . . 编译 + 打包）
#   4. build/build.bat       → Windows 原生编译（不使用 Docker）
#
# BuildKit 使用 COPY . . 时将包含上下文里所有未被排除的文件。
# 下面排除大体积缓存和构建产物，减小 send context 体积。

# VCS
.git
.gitignore

# IDE / project config
.claude
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# 编译缓存（体积大，BuildKit 运行期通过 --mount=type=cache 管理或 dev 容器用 -v 挂载）
dist/cache/gocache
dist/cache/gocache_dev
dist/cache/gomodcache

# ONNX Runtime 下载缓存（大 tarball，Dockerfile 用不到，解压产物在 build/deps/）
dist/cache/deps/onnxruntime-linux-x64-*.tgz

# 旧的 ONNX Runtime SDK 目录（ensure_onnxruntime.sh 之前放 dist/cache/deps/，现在放 build/deps/）
dist/cache/deps/onnxruntime

# 注意：dist/cache/deps/go*.tar.gz 不能排除 —— build/Dockerfile 用 COPY 引入它。

# 自签名证书源（build.sh 会先复制到 dist/ 再 COPY；key 不应进上下文）
certs
# dist/cert.pem and dist/key.pem are staged by build.sh for Dockerfile.server — allow them.

# 构建产物（multistage build 会生成新的，不需要旧产物发到 daemon）
dist/*.tar
dist/docutil
dist/docutil.exe
dist/docutil-linux-amd64
dist/docutil-windows-amd64
dist/doc-
dist/doc-util-mcp
dist/doc-util
dist/libopencv_*.so.*
dist/libtbb.so*
dist/libonnxruntime.so*
dist/models

# 文档（镜像用不到）
README.md
API.md
CLAUDE.md

# 部署脚本（镜像用不到）
deploy/