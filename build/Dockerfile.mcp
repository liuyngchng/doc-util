# syntax=docker/dockerfile:1
# ================================================================
# Multi-stage production image for the docutil MCP server.
#
# Build:
#   docker buildx build -t doc-util-mcp:$(cat VERSION) \
#     -f build/Dockerfile.mcp \
#     [--build-arg HTTP_PROXY=...] \
#     .
#
# Run (stdin must be attached, stdout is the JSON-RPC transport):
#   docker run -i --rm doc-util-mcp:$(cat VERSION)
#
# Register in Claude Desktop's claude_desktop_config.json:
#   {
#     "mcpServers": {
#       "docutil": {
#         "command": "docker",
#         "args": ["run", "-i", "--rm", "doc-util-mcp:$(cat VERSION)"]
#       }
#     }
#   }
# ================================================================

# ── Build stage ─────────────────────────────────────────────────
FROM doc-util-build:latest AS builder
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -mod=mod -ldflags='-s -w -r $ORIGIN' -o /out/doc-util-mcp ./cmd/mcp/

# ── Runtime ─────────────────────────────────────────────────────
FROM ubuntu:24.04

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""

RUN if [ -n "$HTTP_PROXY" ]; then \
        echo "Acquire::http::Proxy \"$HTTP_PROXY\";" > /etc/apt/apt.conf.d/01proxy; \
    fi; \
    if [ -n "$HTTPS_PROXY" ]; then \
        echo "Acquire::https::Proxy \"$HTTPS_PROXY\";" >> /etc/apt/apt.conf.d/01proxy; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libopencv-core406t64 \
    libopencv-imgproc406t64 \
    libreoffice-writer-nogui \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/01proxy

WORKDIR /app

COPY --from=builder /out/doc-util-mcp /app/doc-util-mcp
# ONNX Runtime shared lib (symlink chain preserved by BuildKit COPY).
COPY build/deps/onnxruntime/lib/libonnxruntime.so* /app/
COPY models /app/models

ENV LOG_LEVEL=info

ENTRYPOINT ["/app/doc-util-mcp"]