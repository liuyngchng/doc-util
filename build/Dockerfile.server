# syntax=docker/dockerfile:1
# ================================================================
# Multi-stage production image for doc-util HTTP server.
#
# Build:
#   docker buildx build -t doc-util:$(cat VERSION) \
#     -f build/Dockerfile.server \
#     [--build-arg HTTP_PROXY=...] \
#     .
#
# Run:
#   docker run -d --rm --name doc-util -p 8443:8080 \
#     -v $(pwd)/logs:/app/logs \
#     doc-util:$(cat VERSION)
# ================================================================

# ── Build stage ─────────────────────────────────────────────────
FROM doc-util-build:latest AS builder
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -mod=mod -ldflags='-s -w -r $ORIGIN' -o /out/doc-util ./cmd/server/

# ── Runtime ─────────────────────────────────────────────────────
FROM ubuntu:24.04

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""

RUN if [ -n "$HTTP_PROXY" ]; then \
        echo "Acquire::http::Proxy \"$HTTP_PROXY\";" > /etc/apt/apt.conf.d/01proxy; \
    fi; \
    if [ -n "$HTTPS_PROXY" ]; then \
        echo "Acquire::https::Proxy \"$HTTPS_PROXY\";" >> /etc/apt/apt.conf.d/01proxy; \
    fi

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libopencv-core406t64 \
    libopencv-imgproc406t64 \
    libreoffice-writer-nogui \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/01proxy

WORKDIR /app

COPY --from=builder /out/doc-util /app/doc-util
# ONNX Runtime shared lib (symlink chain preserved by BuildKit COPY).
COPY build/deps/onnxruntime/lib/libonnxruntime.so* /app/
COPY models /app/models

# Self-signed TLS certificate (generated by build/gen_cert.sh, staged to dist/).
# Set these env vars to enable HTTPS — the server falls back to HTTP
# when the files are missing or the vars are unset.
COPY dist/cert.pem dist/key.pem /app/
ENV TLS_CERT_FILE=/app/cert.pem
ENV TLS_KEY_FILE=/app/key.pem

ENV PORT=8080
ENV LOG_DIR=/app/logs

VOLUME ["/app/logs"]
EXPOSE 8080
ENTRYPOINT ["/app/doc-util"]